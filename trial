#!/bin/bash
clear
DOMAIN=$(cat /etc/xray/domain 2>/dev/null || echo "lance.gregsmarty.co.uk")
NS_DOMAIN=$(cat /etc/xray/nsdomain 2>/dev/null || echo "ns-$DOMAIN")
PUBKEY=$(cat /etc/slowdns/server.pub 2>/dev/null || echo "Not Configured")
IP=$(curl -s ifconfig.me || hostname -I | awk '{print $1}')

printf "\033[1;33m              CREATE TRIAL ACCOUNT                \033[0m\n"
printf "\033[1;34m──────────────────────────────────────────────────\033[0m\n"
read -p "Max Login (Default 1): " max_login
: ${max_login:=1}

user="trial$(tr -dc 'a-z0-9' </dev/urandom | head -c 4)"
pass="pass$(tr -dc '0-9' </dev/urandom | head -c 4)"
expdays=1
exp=$(date -d "+$expdays days" +"%b %d, %Y" 2>/dev/null || echo "Tomorrow")
exp_date=$(date -d "+$expdays days" +"%Y-%m-%d" 2>/dev/null || echo "")

useradd -e "$exp_date" -M -s /bin/false "$user" &>/dev/null
echo "$user:$pass" | chpasswd &>/dev/null

clear
printf "\033[1;34m──────────────────────────────────────────────────\033[0m\n"
printf "\033[1;32m             PREMIUM TRIAL ACCOUNT                \033[0m\n"
printf "\033[1;34m──────────────────────────────────────────────────\033[0m\n"
printf "Username       : %s\n" "$user"
printf "Password       : %s\n" "$pass"
printf "Max Login      : %s Connection(s)\n" "$max_login"
printf "Expired On     : %s\n" "$exp"
printf "\033[1;34m──────────────────────────────────────────────────\033[0m\n"
printf "\033[1;33m               SERVER INFORMATION                 \033[0m\n"
printf "\033[1;34m──────────────────────────────────────────────────\033[0m\n"
printf "IP             : %s\n" "$IP"
printf "Host           : %s\n" "$DOMAIN"
printf "Nameserver     : %s\n" "$NS_DOMAIN"
printf "PubKey         : %s\n" "$PUBKEY"
printf "OpenSSH        : 22\n"
printf "SSH-WS         : 80\n"
printf "Custom SSH     : 8880\n"
printf "SSH-SSL-WS     : 443\n"
printf "Dropbear       : 109, 143\n"
printf "SSL/TLS        : 443, 444\n"
printf "UDPGW          : 7100-7300\n"
printf "SOCKS5         : 1080\n"
printf "OVPN TCP       : http://%s:85/client-tcp.ovpn\n" "$DOMAIN"
printf "OVPN UDP       : http://%s:85/client-udp.ovpn\n" "$DOMAIN"
printf "\033[1;34m──────────────────────────────────────────────────\033[0m\n"
printf "SSH-80         : %s:80@%s:%s\n" "$DOMAIN" "$user" "$pass"
printf "SSH-8880       : %s:8880@%s:%s\n" "$DOMAIN" "$user" "$pass"
printf "SSH-443        : %s:443@%s:%s\n" "$DOMAIN" "$user" "$pass"
printf "SOCKS5         : %s:1080@%s:%s\n" "$DOMAIN" "$user" "$pass"
printf "HTTP Proxy     : %s:8080@%s:%s\n" "$DOMAIN" "$user" "$pass"
printf "\033[1;34m──────────────────────────────────────────────────\033[0m\n"
printf "\033[1;36m(Payload WSS)\033[0m\n"
printf "GET wss://bug.com [protocol][crlf]Host: %s[crlf]Upgrade: websocket[crlf][crlf]\n\n" "$DOMAIN"
printf "\033[1;36m(Payload WS - Port 80)\033[0m\n"
printf "GET / HTTP/1.1[crlf]Host: %s[crlf]Upgrade: websocket[crlf][crlf]\n\n" "$DOMAIN"
printf "\033[1;36m(Payload Custom Bypass - Port 8880)\033[0m\n"
printf "GET http://%s:8880 HTTP/1.1[crlf]Host: [ISP_BUG_HOST][crlf]Upgrade: websocket[crlf]Connection: Upgrade[crlf][crlf]\n" "$DOMAIN"
printf "\033[1;34m──────────────────────────────────────────────────\033[0m\n"
printf "\033[1;32mPress any key to back on menu...\033[0m"
read -n 1 -s
